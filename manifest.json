{
  "manifest_version": 3,
  "name": "Satori",
  "version": "0.3.0",
  "description": "A practice-study assistant for MCQs and coding questions using ChatGPT in the browser.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://chat.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Satori",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt.js"],
      "run_at": "document_idle"
    }
  ]
}
